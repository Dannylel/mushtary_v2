# ── LLM configuration (local-first) ───────────────────────────────────────────
# Defaults target a local Ollama server. Override any of these to switch models or
# point at a different OpenAI-compatible endpoint (LM Studio, vLLM, OpenRouter...).

# OpenAI-compatible endpoint. Ollama default shown below.
LLM_BASE_URL="http://localhost:11434/v1"

# Model id/tag served by that endpoint. Must match an `ollama list` tag exactly.
# Tool-capable models recommended (Agent 1 needs function calling), e.g.
# qwen2.5:7b-instruct-q4_K_M (default), qwen3:4b, llama3.1:8b.
LLM_MODEL="qwen2.5:7b-instruct-q4_K_M"

# Local servers ignore the key, but the openai SDK needs a non-empty string.
LLM_API_KEY="ollama"

# Embedding model for the RAG layer (served by the same endpoint).
RAG_EMBED_MODEL="qwen3-embedding:0.6b"
