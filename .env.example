# ── LLM configuration (local-first) ───────────────────────────────────────────
# Provider: "ollama" for local models or "gemini" for Gemini API via OpenAI compatibility.
LLM_PROVIDER="ollama"

# OpenAI-compatible endpoint. Used when LLM_PROVIDER="ollama".
LLM_BASE_URL="http://localhost:11434/v1"

# Model id/tag served by that endpoint. Must match an `ollama list` tag exactly.
# Tool-capable models recommended (Agent 1 needs function calling), e.g.
# qwen3:4b is the project default for local tender generation and AI review agents.
LLM_MODEL="qwen3:4b"

# Gemini API config. Put your real key in .env, never commit it.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Local servers ignore the key, but the OpenAI SDK needs a non-empty string for Ollama.
LLM_API_KEY="ollama"

# Production reliability controls for generation calls.
LLM_TIMEOUT_SECONDS="120"
LLM_MAX_RETRIES="2"
LLM_MAX_CONCURRENCY="4"
LLM_CIRCUIT_FAILURE_THRESHOLD="5"
LLM_CIRCUIT_COOLDOWN_SECONDS="60"
AI_EVENT_RETENTION_DAYS="30"
MAX_SOW_UPLOAD_BYTES="26214400"
AI_TASK_SOFT_TIME_LIMIT="300"
AI_TASK_HARD_TIME_LIMIT="330"

# Demo-session signing. Set a long random value in deployed environments.
MUSHTARY_SESSION_SECRET=""
MUSHTARY_SESSION_TTL_SECONDS="28800"

# Embedding model for the RAG layer (served by the same endpoint).
RAG_EMBED_MODEL="qwen3-embedding:0.6b"
RAG_TOP_K="4"
RAG_MIN_SCORE="0.30"
RAG_MAX_CONCURRENCY="2"
